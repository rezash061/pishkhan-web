# Backend Api host (public endpoints are under /api/v1/public). Server-side only.
PISHKHAN_API_URL=http://localhost:5080
# Public origin of this site (canonical URLs, sitemap, Open Graph).
SITE_URL=https://pishkhan.ir
# User panel origin («شروع رایگان» and «ورود» link here).
PANEL_URL=https://app.pishkhan.ir
# waitlist (closed beta) or signup (public launch).
SIGNUP_MODE=waitlist
# Shared HMAC secret for POST /api/revalidate, set the same value in the backend Content module. Empty disables it.
REVALIDATE_SECRET=
# Self-hosted Umami: base URL (proxied first-party under /stats) and website id. Empty disables analytics.
UMAMI_URL=
UMAMI_WEBSITE_ID=
# Development and CI only: show sample plans when GET /public/plans is unavailable. Never set in production.
PLANS_FALLBACK=fixtures
